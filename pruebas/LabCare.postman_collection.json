{
  "info": {
    "name": "LabCare — Solicitudes de mantenimiento",
    "description": "Casos CP-01 a CP-15 del examen integrador. Ejecutar en orden con el Collection Runner: los casos encadenan ids mediante variables de colección. Cambiar baseUrl para probar en Vercel.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "idSolicitud",
      "value": ""
    },
    {
      "key": "idEliminar",
      "value": ""
    },
    {
      "key": "codigoSolicitud",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "CP-01: Registrar solicitud con datos válidos y equipo existente",
      "description": "Se crea PENDIENTE, con código único y persistencia.",
      "item": [
        {
          "name": "CP-01a POST crear solicitud válida",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const s = pm.response.json();",
                  "pm.test(\"estado PENDIENTE\", () => pm.expect(s.estado).to.eql(\"PENDIENTE\"));",
                  "pm.test(\"código SOL-AAAAMMDD-XXX\", () => pm.expect(s.codigoSolicitud).to.match(/^SOL-\\d{8}-\\d{3,}$/));",
                  "pm.collectionVariables.set(\"idSolicitud\", s.id);",
                  "pm.collectionVariables.set(\"codigoSolicitud\", s.codigoSolicitud);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/solicitudes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "solicitudes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipoId\": 3,\n  \"solicitante\": \"María Quispe\",\n  \"descripcion\": \"El router no asigna direcciones IP a los equipos.\",\n  \"prioridad\": \"ALTA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "CP-01b GET verificar persistencia",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"mismo código persistido\", () => pm.expect(pm.response.json().codigoSolicitud).to.eql(pm.collectionVariables.get(\"codigoSolicitud\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/solicitudes/{{idSolicitud}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "solicitudes",
                "{{idSolicitud}}"
              ]
            }
          }
        }
      ]
    },
